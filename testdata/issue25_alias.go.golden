package testdata

import (
	"github.com/ghostiam/protogetter/testdata/proto"
)

// testIssue25AliasTest is an alias of a message, as a package re-exporting one declares it. Go materialises
// aliases, so an expression of this type holds a types.Alias rather than the types.Named it
// aliases.
type testIssue25AliasTest = proto.Test

func testIssue25Alias_read(t *testIssue25AliasTest) string {
	return t.GetS() // want `avoid direct access to proto field t\.S, use t\.GetS\(\) instead`
}

func testIssue25Alias_readEmbedded(t *testIssue25AliasTest) string {
	return t.GetEmbedded().GetS() // want `avoid direct access to proto field t\.Embedded\.S, use t\.GetEmbedded\(\)\.GetS\(\) instead`
}

func testIssue25Alias_write(t *testIssue25AliasTest) {
	t.S = "value"
}

func testIssue25Alias_getter(t *testIssue25AliasTest) string {
	return t.GetS()
}
